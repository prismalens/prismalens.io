{
  "name": "prismalens.io",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "fast-xml-parser": ">=5.3.6",
      "shell-quote": "^1.11.0",
      "postcss-nested>postcss-selector-parser": "^7.1.6"
    }
  },
  "scripts": {
    "dev": "concurrently \"pnpm dev:site\" \"pnpm dev:docs\" --names \"site,docs\" --prefix-colors \"cyan,magenta\"",
    "dev:site": "pnpm --filter site dev",
    "dev:docs": "pnpm --filter docs dev",
    "build:site": "pnpm --filter site build",
    "build:docs": "pnpm --filter docs build",
    "docs:generate": "tsx scripts/generate-env-docs.ts",
    "docs:generate:watch": "tsx watch scripts/generate-env-docs.ts",
    "docs:generate:integrations": "tsx scripts/generate-integration-docs.ts",
    "tokens:sync": "tsx scripts/sync-design-tokens.ts",
    "test": "tsx --test scripts/analytics.test.ts",
    "check": "vale docs/src/content site/dist && lychee --offline --root-dir \"$PWD/docs/dist\" 'docs/dist/**/*.html' && lychee --offline --root-dir \"$PWD/site/dist\" 'site/dist/**/*.html'",
    "check:a11y": "cd site && npx -y @lhci/cli@0.15.1 autorun && cd ../docs && npx -y @lhci/cli@0.15.1 autorun"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15"
  }
}
