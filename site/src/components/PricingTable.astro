---
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'

interface Plan {
  name: string
  price: string
  description: string
  features: string[]
  cta: { href: string; label: string }
  highlighted?: boolean
}

interface Props {
  plans: Plan[]
}

const { plans } = Astro.props
---

<section class="px-4 py-24 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        plans.map((plan) => (
          <div
            class:list={[
              'rounded-xl border p-8 shadow-sm',
              plan.highlighted
                ? 'border-primary bg-primary/5'
                : 'border-border bg-card/50',
            ]}
          >
            <h3 class="text-lg font-semibold text-foreground">{plan.name}</h3>
            <div class="mt-4">
              <span class="text-4xl font-bold text-foreground">{plan.price}</span>
            </div>
            <p class="mt-2 text-sm text-muted-foreground">{plan.description}</p>
            <ul class="mt-6 space-y-3">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm text-muted-foreground">
                  <span class="mt-0.5 text-primary">&#10003;</span>
                  {feature}
                </li>
              ))}
            </ul>
            <a
              href={plan.cta.href}
              class={cn(
                'mt-8 block text-center',
                plan.highlighted
                  ? buttonVariants({ variant: 'default' })
                  : buttonVariants({ variant: 'outline' }),
              )}
            >
              {plan.cta.label}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
