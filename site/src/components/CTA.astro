---
import Icon from './Icon.astro'

interface Props {
  title: string
  description: string
  href: string
  label: string
}

const { title, description, href, label } = Astro.props
---

<section class="relative px-4 py-24 sm:px-6 lg:px-8 overflow-hidden" style="background: linear-gradient(to top, color-mix(in srgb, var(--primary) 5%, transparent) 0%, transparent 100%);">
  <div class="mx-auto max-w-4xl relative">
    <div class="rounded-3xl p-16 text-center backdrop-blur-xl cta-card-bg" style="box-shadow: 0 20px 60px color-mix(in srgb, var(--primary) 30%, transparent);">
      <!-- Glowing background effect -->
      <div class="absolute inset-0 rounded-3xl -z-10" style="background: linear-gradient(135deg, color-mix(in srgb, var(--primary) 10%, transparent) 0%, color-mix(in srgb, var(--pl-investigation-purple) 10%, transparent) 100%); filter: blur(40px);"></div>

      <h2 class="text-4xl font-bold tracking-tight sm:text-5xl mb-6 cta-title">{title}</h2>
      <p class="mx-auto mt-4 max-w-2xl text-xl leading-relaxed cta-description">{description}</p>

      <a
        href={href}
        class="group relative mt-10 inline-flex items-center gap-3 rounded-xl px-10 py-5 text-lg font-bold transition-all hover:scale-105 overflow-hidden"
        style="background: linear-gradient(135deg, var(--primary) 0%, var(--pl-investigation-purple) 100%); color: var(--primary-foreground); box-shadow: 0 20px 40px color-mix(in srgb, var(--primary) 40%, transparent);"
      >
        <span class="relative z-10">{label}</span>
        <Icon name="arrow-right" size={24} class="relative z-10 transition-transform group-hover:translate-x-1" />
        <div class="absolute inset-0 bg-gradient-to-r from-white/0 via-white/20 to-white/0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000"></div>
      </a>
    </div>
  </div>
</section>
