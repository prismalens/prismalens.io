---
import ThemeToggle from './react/ThemeToggle.tsx'
import MobileNav from './react/MobileNav.tsx'
import Mark from './Mark.astro'

const navLinks = [
  { href: import.meta.env.DEV ? 'http://localhost:4322' : 'https://docs.prismalens.io', label: 'Docs' },
  { href: '/about', label: 'About' },
  { href: 'https://github.com/prismalens/prismalens', label: 'GitHub' },
]
---

<header class="sticky top-0 z-50 border-b border-border bg-background">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 text-lg font-semibold tracking-tight">
      <Mark size={22} />
      <span><span class="text-primary">Prisma</span>Lens</span>
    </a>

    <div class="hidden items-center gap-7 md:flex">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm text-muted-foreground transition-colors hover:text-foreground">
          {link.label}
        </a>
      ))}
      <ThemeToggle client:load />
    </div>

    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle client:load />
      <MobileNav client:load navLinks={navLinks} />
    </div>
  </nav>
</header>
