---
import { badgeVariants } from '@/components/ui/badge'
import { cn } from '@/lib/utils'

interface Props {
  title: string
  description: string
  pubDate: Date
  slug: string
  heroImage?: string
  tags?: string[]
}

const { title, description, pubDate, slug, heroImage, tags = [] } = Astro.props

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}
---

<article class="group rounded-xl border border-border bg-card/50 shadow-sm transition-colors hover:border-primary/40">
  <a href={`/blog/${slug}`} class="block p-6">
    {
      heroImage && (
        <img
          src={heroImage}
          alt={title}
          class="mb-4 aspect-video w-full rounded-lg object-cover"
        />
      )
    }
    <div class="mb-2 flex flex-wrap gap-2">
      {
        tags.map((tag) => (
          <span class={cn(badgeVariants({ variant: 'secondary' }), 'bg-primary/10 text-primary')}>
            {tag}
          </span>
        ))
      }
    </div>
    <h3 class="mb-2 text-lg font-semibold text-foreground group-hover:text-primary transition-colors">
      {title}
    </h3>
    <p class="mb-3 text-sm text-muted-foreground line-clamp-2">{description}</p>
    <time datetime={pubDate.toISOString()} class="text-xs text-muted-foreground">
      {formatDate(pubDate)}
    </time>
  </a>
</article>
