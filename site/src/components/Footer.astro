---
const currentYear = new Date().getFullYear()

const footerLinks = {
  Product: [
    { href: '/features', label: 'Features' },
    { href: '/pricing', label: 'Pricing' },
    { href: 'https://docs.prismalens.io', label: 'Documentation' },
  ],
  Company: [
    { href: '/about', label: 'About' },
    { href: '/blog', label: 'Blog' },
  ],
  Resources: [
    { href: 'https://github.com/prismalens', label: 'GitHub' },
    { href: '/rss.xml', label: 'RSS Feed' },
  ],
}
---

<footer class="border-t border-gray-800 bg-gray-950">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <div class="col-span-2 md:col-span-1">
        <span class="text-lg font-bold text-white">PrismaLens</span>
        <p class="mt-2 text-sm text-gray-400">
          AI-powered root cause analysis for production incidents.
        </p>
      </div>
      {
        Object.entries(footerLinks).map(([title, links]) => (
          <div>
            <h3 class="mb-3 text-sm font-semibold text-white">{title}</h3>
            <ul class="space-y-2">
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-gray-400 transition-colors hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-8 border-t border-gray-800 pt-8 text-center text-sm text-gray-500">
      &copy; {currentYear} PrismaLens. All rights reserved.
    </div>
  </div>
</footer>
