---
const currentYear = new Date().getFullYear()

const footerLinks = {
  Product: [
    { href: '/features', label: 'Features' },
    { href: 'https://docs.prismalens.io', label: 'Documentation' },
  ],
  Company: [
    { href: '/about', label: 'About' },
    { href: '/blog', label: 'Blog' },
  ],
  Resources: [
    { href: 'https://github.com/prismalens', label: 'GitHub' },
    { href: '/rss.xml', label: 'RSS Feed' },
  ],
}
---

<footer class="footer-bg">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <div class="col-span-2 md:col-span-1">
        <span class="text-lg font-bold">
          <span style="color: var(--primary);">Prisma</span><span class="logo-lens">Lens</span>
        </span>
        <p class="mt-2 text-sm footer-text">
          AI-powered root cause analysis for production incidents.
        </p>
      </div>
      {
        Object.entries(footerLinks).map(([title, links]) => (
          <div>
            <h3 class="mb-3 text-sm font-semibold footer-heading">{title}</h3>
            <ul class="space-y-2">
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    class="text-sm transition-colors footer-text hover:text-primary"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-8 pt-8 text-center text-sm footer-copyright" style="border-top: 1px solid var(--border);">
      &copy; {currentYear} PrismaLens. All rights reserved.
    </div>
  </div>
</footer>
