---
import Mark from './Mark.astro'

const links = [
  { href: import.meta.env.DEV ? 'http://localhost:4322' : 'https://docs.prismalens.io', label: 'Docs' },
  { href: '/about', label: 'About' },
  { href: 'https://github.com/prismalens/prismalens', label: 'GitHub' },
  { href: 'https://github.com/prismalens/prismalens/issues', label: 'Report a problem' },
]
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p class="flex items-center gap-2">
      <Mark size={18} />
      PrismaLens is open source under the Apache-2.0 license. Docs are CC-BY-4.0.
    </p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {links.map((link) => (
        <li><a href={link.href} class="transition-colors hover:text-foreground">{link.label}</a></li>
      ))}
    </ul>
  </div>
</footer>
