---
import { installChannels } from '../lib/links'

interface Props {
  /** Prefixes element ids, so the box can appear more than once on a page. */
  name: string
  class?: string
  center?: boolean
}
const { name, class: className, center = false } = Astro.props
const primary = installChannels.filter((c) => c.primary)
const more = installChannels.filter((c) => !c.primary)
// analytics.ts counts copies on `.expressive-code .copy button` and reads the command from that box's <pre>.
---

<div class:list={['installer', className, { center }]} data-installer>
  <div class="seg" role="group" aria-label="Install with">
    {primary.map((c, i) => (
      <button type="button" class="pick" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`${name}-panel-${c.id}`} data-channel={c.id} data-os={c.os}>
        {c.label}
      </button>
    ))}
  </div>

  {installChannels.map((c, i) => (
    <div class="panel" id={`${name}-panel-${c.id}`} aria-label={`Install with ${c.label}`} hidden={i !== 0}>
      {c.commands ? (
        <div class="install expressive-code">
          <pre tabindex="0">{c.commands.map((cmd) => <span class="line"><span class="p" aria-hidden="true">$</span>{cmd}</span>)}</pre>
          <div class="copy">
            <button class="copy-btn" type="button" data-copy={c.commands.join('\n')} aria-label={`Copy the ${c.label} install command`}>
              <span class="idle">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.5"></rect><path d="M10.5 5V3.5A1.5 1.5 0 009 2H3.5A1.5 1.5 0 002 3.5V9A1.5 1.5 0 003.5 10.5H5"></path></svg>
                <span class="lbl">Copy</span>
              </span>
              <span class="done">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8.5l3 3 7-7"></path></svg>
                <span class="lbl">Copied</span>
              </span>
            </button>
          </div>
        </div>
      ) : (
        <div class="install download">
          <a class="btn btn-primary" href={c.download}>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M8 2v8M4.5 6.5L8 10l3.5-3.5M2.5 13.5h11"></path></svg>
            Download the app
          </a>
        </div>
      )}
    </div>
  ))}

  <div class="foot">
    <p class="next">
      {installChannels.filter((c) => c.preview).map((c) => (
        <span class="badge" data-preview-for={c.id} hidden>Preview</span>
      ))}
      Then run <code>pl up</code>
    </p>
    <p class="more" role="group" aria-label="Other ways to install">
      <span>Also</span>
      {more.map((c) => (
        <button type="button" class="pick link" aria-pressed="false" aria-controls={`${name}-panel-${c.id}`} data-channel={c.id}>
          {c.label}
        </button>
      ))}
    </p>
  </div>
</div>

<script>
  const copyText = async (s: string) => {
    try {
      await navigator.clipboard.writeText(s)
      return true
    } catch {
      const ta = Object.assign(document.createElement('textarea'), { value: s })
      ta.style.cssText = 'position:fixed;opacity:0'
      document.body.appendChild(ta)
      ta.select()
      const ok = document.execCommand('copy')
      ta.remove()
      return ok
    }
  }
  const timers = new WeakMap<HTMLElement, number>()
  document.querySelectorAll<HTMLButtonElement>('[data-installer] .copy-btn').forEach((b) =>
    b.addEventListener('click', async () => {
      const ok = await copyText(b.dataset.copy ?? '')
      const status = document.getElementById('copyStatus')
      if (status) status.textContent = ok ? 'Copied' : 'Copy failed'
      b.classList.add('copied')
      clearTimeout(timers.get(b))
      timers.set(b, window.setTimeout(() => b.classList.remove('copied'), 1800))
    }),
  )

  const ua = navigator.userAgent
  const os = /Windows/i.test(ua) ? 'windows' : /Mac|Linux|X11|CrOS/i.test(ua) && !/Android|iPhone|iPad/i.test(ua) ? 'unix' : null

  document.querySelectorAll<HTMLElement>('[data-installer]').forEach((box) => {
    const picks = [...box.querySelectorAll<HTMLButtonElement>('.pick')]
    const select = (pick: HTMLButtonElement) =>
      picks.forEach((p) => {
        const on = p === pick
        p.setAttribute('aria-pressed', String(on))
        box.querySelector<HTMLElement>(`#${p.getAttribute('aria-controls')}`)!.hidden = !on
        const badge = box.querySelector<HTMLElement>(`[data-preview-for="${p.dataset.channel}"]`)
        if (badge) badge.hidden = !on
      })
    picks.forEach((p) => p.addEventListener('click', () => select(p)))
    const preferred = os && picks.find((p) => p.dataset.os === os)
    if (preferred) select(preferred)
  })
</script>

<style>
  .installer {
    max-width: 560px;
    min-width: 0;
  }
  .seg {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
    padding: 3px;
    margin-bottom: 8px;
    border-radius: 10px;
    border: 1px solid oklch(1 0 0 / 0.08);
    background: oklch(1 0 0 / 0.03);
  }
  .seg .pick {
    height: 30px;
    padding: 0 8px;
    border-radius: 7px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted-foreground);
    font: 500 12.5px/1 var(--font-sans);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }
  .seg .pick:hover {
    color: var(--foreground);
  }
  .seg .pick[aria-pressed='true'] {
    color: var(--foreground);
    background: var(--indigo-soft);
    border-color: color-mix(in oklch, var(--primary) 40%, transparent);
  }
  .badge {
    margin-right: 8px;
    font: 500 11px/1 var(--font-sans);
    padding: 5px 8px;
    border-radius: 999px;
    color: var(--warning);
    background: color-mix(in oklch, var(--warning) 12%, transparent);
    border: 1px solid color-mix(in oklch, var(--warning) 35%, transparent);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 12px;
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 4px;
    margin: 0;
    font-size: 13px;
    color: var(--muted-foreground);
  }
  .more span {
    margin-right: 4px;
  }
  .more .link {
    padding: 4px 6px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted-foreground);
    font: inherit;
    text-decoration: underline;
    text-decoration-color: oklch(1 0 0 / 0.2);
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .more .link:hover,
  .more .link[aria-pressed='true'] {
    color: var(--foreground);
    text-decoration-color: currentColor;
  }
  .install {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 7px 7px 7px 16px;
    border-radius: 12px;
    border: 1px solid oklch(1 0 0 / 0.12);
    background: color-mix(in oklch, var(--bg-deep) 85%, transparent);
    box-shadow: 0 20px 50px -28px oklch(0 0 0 / 0.9), 0 0 0 1px oklch(0 0 0 / 0.4);
    text-align: left;
  }
  .download {
    padding-left: 7px;
  }
  pre {
    margin: 0;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.6;
    color: var(--foreground);
    /* Wrap rather than hide: a command cut off at the edge looks complete. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    scrollbar-width: none;
    border-radius: 6px;
  }
  pre::-webkit-scrollbar {
    display: none;
  }
  .line {
    display: block;
    padding-left: 1.6em;
    text-indent: -1.6em;
  }
  .p {
    color: var(--link);
    user-select: none;
    margin-right: 10px;
  }
  .copy {
    flex: none;
    align-self: flex-start;
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 11px;
    border-radius: 8px;
    border: 1px solid oklch(1 0 0 / 0.12);
    background: oklch(1 0 0 / 0.05);
    color: var(--muted-foreground);
    font: 500 12px/1 var(--font-sans);
    cursor: pointer;
    transition: all 0.2s;
  }
  .copy-btn:hover {
    color: var(--foreground);
    background: oklch(1 0 0 / 0.09);
  }
  .copy-btn svg {
    width: 14px;
    height: 14px;
  }
  .idle,
  .copied .done {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .done,
  .copied .idle {
    display: none;
  }
  .copy-btn.copied {
    color: color-mix(in oklch, var(--run-done) 80%, white);
    border-color: color-mix(in oklch, var(--run-done) 50%, transparent);
    background: color-mix(in oklch, var(--run-done) 10%, transparent);
  }
  .next {
    margin: 0;
    font-size: 13px;
    color: var(--muted-foreground);
  }
  .next code {
    margin-left: 4px;
    padding: 2px 6px;
    border-radius: 5px;
    font-size: 12.5px;
    color: var(--foreground);
    background: oklch(1 0 0 / 0.07);
    border: 1px solid oklch(1 0 0 / 0.06);
  }
  .center {
    margin: 0 auto;
  }
  .center .foot {
    justify-content: center;
  }
  @media (max-width: 420px) {
    .lbl {
      display: none;
    }
    .copy-btn {
      padding: 0 9px;
    }
  }
</style>
