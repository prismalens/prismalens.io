---
interface Props {
  size?: number
}

const { size = 24 } = Astro.props
// Below 24 px the glint turns to mush, so the brand draws the plain, heavier p (#745).
const small = size < 24
const stroke = small ? 46 : 36
---

<svg class="mark" width={size} height={size} viewBox="0 0 256 256" fill="none" aria-hidden="true">
  <g stroke-linecap="round">
    <circle cx="142" cy="104" r="54" stroke-width={stroke} />
    <path d="M88 64V224" stroke-width={stroke} />
    {!small && <path d="M120 108A24 24 0 0 1 144 82" stroke-width="11" />}
  </g>
</svg>

<style>
  .mark g {
    stroke: #4f46e5;
  }

  :global(.dark) .mark g {
    stroke: #818cf8;
  }
</style>
