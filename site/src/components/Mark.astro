---
interface Props {
  size?: number
}

const { size = 24 } = Astro.props
---

<svg class="mark" width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true">
  <g stroke-linecap="round">
    <path d="M2 34H20" stroke="currentColor" opacity=".55" stroke-width="3" />
    <path d="M20.6 34 40.4 29.6" stroke="currentColor" opacity=".22" stroke-width="2.5" />
    <path class="r" d="M42.8 28.3 62 17" stroke-width="3" />
    <path class="r" d="M43.2 29 62 26" stroke-width="3" opacity=".7" />
    <path class="r" d="M43.9 30.2 62 35" stroke-width="3" opacity=".5" />
    <path class="r" d="M44.4 31 62 44" stroke-width="3" opacity=".35" />
    <path d="M32 14.1 51 47H13Z" stroke="currentColor" stroke-width="3.5" stroke-linejoin="round" />
  </g>
</svg>

<style>
  .r {
    stroke: #4f46e5;
  }

  :global(.dark) .r {
    stroke: #818cf8;
  }
</style>
