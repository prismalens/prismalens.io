---
import Icon from './Icon.astro'

interface Props {
  title: string
  subtitle: string
  code?: string
  primaryCta?: { href: string; label: string }
  secondaryCta?: { href: string; label: string }
}

const { title, subtitle, code, primaryCta, secondaryCta } = Astro.props
---

<section class="relative overflow-hidden px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
  <!-- Grid background with blue glow -->
  <div class="absolute inset-0 -z-10 grid-background">
    <div class="absolute left-1/2 top-0 h-[600px] w-[1000px] -translate-x-1/2 rounded-full" style="background: radial-gradient(circle, color-mix(in srgb, var(--primary) 20%, transparent) 0%, transparent 70%);"></div>
  </div>

  <div class="mx-auto max-w-4xl text-center">
    <!-- Project badge (static — this is a marketing page, not a live status page) -->
    <div class="mb-8 inline-flex items-center gap-2 rounded-full px-4 py-2 backdrop-blur-sm" style="border: 1px solid color-mix(in srgb, var(--success) 30%, transparent); background: color-mix(in srgb, var(--success) 5%, transparent); box-shadow: 0 4px 6px color-mix(in srgb, var(--success) 10%, transparent);">
      <span class="inline-flex h-2.5 w-2.5 rounded-full" style="background-color: var(--success);"></span>
      <span class="text-sm font-mono font-medium" style="color: var(--success);">Open source · Apache-2.0</span>
    </div>

    <h1 class="text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl mb-6 hero-title">
      {title}
    </h1>
    <p class="mx-auto max-w-2xl text-xl sm:text-2xl leading-relaxed hero-subtitle">
      {subtitle}
    </p>

    {code && (
      <div
        class="terminal-glow mx-auto mt-10 max-w-md rounded-xl px-6 py-4 text-left backdrop-blur-sm"
        style="border: 1px solid var(--border); background: color-mix(in srgb, var(--card) 70%, transparent);"
      >
        <div class="flex items-center gap-1.5 mb-3">
          <span class="h-2.5 w-2.5 rounded-full" style="background: var(--destructive);"></span>
          <span class="h-2.5 w-2.5 rounded-full" style="background: var(--warning, #eab308);"></span>
          <span class="h-2.5 w-2.5 rounded-full" style="background: var(--success);"></span>
        </div>
        <code class="font-mono text-base sm:text-lg" style="color: var(--foreground);">
          <span style="color: var(--muted-foreground);">$</span> {code}
        </code>
      </div>
    )}

    {(primaryCta || secondaryCta) && (
      <div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
        {primaryCta && (
          <a
            href={primaryCta.href}
            class="group relative rounded-xl px-8 py-4 text-base font-bold transition-all hover:scale-105 overflow-hidden"
            style="background: linear-gradient(135deg, var(--primary) 0%, oklch(0.511 0.262 276.966) 100%); color: var(--primary-foreground); box-shadow: 0 10px 40px color-mix(in srgb, var(--primary) 40%, transparent);"
          >
            <span class="relative z-10 flex items-center gap-2">
              {primaryCta.label}
              <Icon name="arrow-right" size={20} strokeWidth={3} class="transition-transform group-hover:translate-x-1" />
            </span>
            <div class="absolute inset-0 bg-gradient-to-r from-white/0 via-white/20 to-white/0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000"></div>
          </a>
        )}
        {secondaryCta && (
          <a
            href={secondaryCta.href}
            class="group rounded-xl border-2 px-8 py-4 text-base font-bold backdrop-blur-sm transition-all hover:scale-105"
            style="border-color: var(--border); background: color-mix(in srgb, var(--card) 60%, transparent); color: var(--foreground); box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);"
          >
            <span class="flex items-center gap-2">
              {secondaryCta.label}
              <Icon name="arrow-right" size={20} strokeWidth={2.5} class="transition-transform group-hover:translate-x-1" />
            </span>
          </a>
        )}
      </div>
    )}
  </div>
</section>
