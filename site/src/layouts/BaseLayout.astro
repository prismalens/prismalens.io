---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import StructuredData from '../components/seo/StructuredData.astro'
import { siteDescription } from '../lib/structured-data'

interface Props {
  title: string
  description?: string
  ogImage?: string
  ogImageWidth?: number
  ogImageHeight?: number
  ogImageAlt?: string
}

const {
  title,
  description = siteDescription,
  ogImage = '/og-default.png',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const isNotFound = Astro.url.pathname.startsWith('/404')
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | PrismaLens</title>
    <meta name="description" content={description} />
    {isNotFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PrismaLens" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | PrismaLens`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <StructuredData />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <p class="sr-only" id="copyStatus" role="status" aria-live="polite"></p>
    <script>
      import { initAnalytics } from '../scripts/analytics'
      import { initReveals } from '../scripts/reveal'
      initReveals()
      initAnalytics().catch(() => {})
    </script>
  </body>
</html>
