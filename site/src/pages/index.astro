---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import FeatureGrid from '../components/FeatureGrid.astro'
import CTA from '../components/CTA.astro'
import Icon from '../components/Icon.astro'

const docsBase = import.meta.env.DEV ? 'http://localhost:4322' : 'https://docs.prismalens.io'

const features = [
  {
    title: 'Read-only AI investigation',
    description: 'Point it at a repo, pipe in a firing alert (or describe the problem with --query). PrismaLens investigates the same way an on-call engineer would and returns a report.',
    icon: 'search',
  },
  {
    title: 'Ordered evidence, not guesses',
    description: 'Hypotheses ranked most to least plausible, each backed by evidence it actually gathered — what was ruled out, what was covered, and what to check next. No numeric confidence scores.',
    icon: 'activity',
  },
  {
    title: 'Bring your own model, no account',
    description: 'Works with Ollama, OpenAI, Groq, any OpenAI-compatible endpoint, or a Claude Code install. No PrismaLens account, no subscription — your keys, your provider.',
    icon: 'link',
  },
  {
    title: 'An enforced sandbox, honestly reported',
    description: '--sandbox runs the investigation behind an OS-level egress boundary when one is available, and every report states what was requested vs. what was actually applied.',
    icon: 'shield',
  },
  {
    title: 'Every run saved locally',
    description: 'Reports and full event streams persist to ~/.prismalens/runs/. Use --json to pipe results into your own scripts and dashboards.',
    icon: 'unlock',
  },
  {
    title: '`pl doctor` before you run anything',
    description: 'Preflights your setup — harness binary on PATH, a model credential set, a writable workspace — so failures surface before an investigation starts, not mid-run.',
    icon: 'check',
  },
]
---

<BaseLayout title="PrismaLens CLI — AI root-cause investigation from your terminal">
  <Hero
    title="Point it at a repo. Get an ordered root cause back."
    subtitle="The PrismaLens CLI investigates a firing alert the way an on-call engineer would — it reads the repo, queries your read-only telemetry, and returns hypotheses ranked most to least plausible, each linked to the evidence behind it."
    code="npx prismalens doctor"
    primaryCta={{ href: `${docsBase}/cli/`, label: 'Read the CLI docs' }}
    secondaryCta={{
      href: 'https://github.com/prismalens/prismalens',
      label: 'View on GitHub',
    }}
  />
  <FeatureGrid features={features} />

  <!-- Why We Built This Section -->
  <section class="relative px-4 py-24 sm:px-6 lg:px-8 overflow-hidden" style="background: linear-gradient(135deg, color-mix(in srgb, var(--primary) 3%, transparent) 0%, transparent 50%, color-mix(in srgb, var(--pl-investigation-purple) 3%, transparent) 100%);">
    <div class="mx-auto max-w-4xl relative">
      <div class="rounded-3xl p-12 backdrop-blur-xl" style="border: 1px solid var(--border); background: linear-gradient(135deg, color-mix(in srgb, var(--card) 90%, transparent) 0%, color-mix(in srgb, var(--background) 90%, transparent) 100%); box-shadow: 0 20px 60px color-mix(in srgb, var(--primary) 10%, transparent);">
        <!-- Accent line -->
        <div class="absolute left-0 top-0 h-1 w-32 rounded-tl-3xl" style="background: linear-gradient(to right, var(--primary) 0%, var(--pl-investigation-purple) 100%);"></div>

        <h2 class="text-4xl font-bold tracking-tight sm:text-5xl mb-8" style="color: var(--foreground);">
          Why We Built This
        </h2>

        <div class="space-y-6" style="color: var(--muted-foreground);">
          <p class="text-lg sm:text-xl leading-relaxed">
            At <span class="font-mono font-bold" style="color: var(--destructive);">2:47am</span>, your payment API times out. You spend the next
            <span class="font-bold" style="color: var(--foreground);">90 minutes</span> jumping between dashboards, grepping logs, and
            correlating deployment times before finding the cause.
          </p>

          <p class="text-lg leading-relaxed">
            You had all the right tools — metrics, logs, traces. The problem wasn't
            <em style="color: var(--muted-foreground);">observability</em>. It was
            <span class="font-bold text-xl" style="color: var(--primary);">correlation</span> — connecting the dots
            takes time and drains focus, especially at 3am.
          </p>

          <div class="my-8 p-6 rounded-xl" style="background: color-mix(in srgb, var(--primary) 10%, transparent); border: 1px solid color-mix(in srgb, var(--primary) 30%, transparent);">
            <p class="text-lg leading-relaxed">
              <strong class="text-xl" style="color: var(--foreground);">The PrismaLens CLI does that legwork for you.</strong> It reads your
              repo, rents a coding-agent harness to gather evidence read-only, and hands back
              a report with hypotheses ordered by plausibility — not a black-box score, a trail
              you can actually check.
            </p>
          </div>

          <p class="text-lg italic pl-6" style="color: var(--foreground); border-left: 4px solid var(--primary);">
            We built PrismaLens because incident response should be about
            <em class="font-bold not-italic" style="color: var(--foreground);">fixing</em> problems, not <em class="not-italic" style="color: var(--muted-foreground);">finding</em> them.
          </p>
        </div>

        <a
          href="/about"
          class="mt-8 inline-flex items-center gap-2 text-base font-semibold transition-all hover:gap-3"
          style="color: var(--primary);"
        >
          Read the full story
          <Icon name="arrow-right" size={20} />
        </a>
      </div>
    </div>
  </section>

  <!-- In development notice -->
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl rounded-2xl p-8 text-center" style="border: 1px dashed var(--border); background: color-mix(in srgb, var(--card) 60%, transparent);">
      <h2 class="text-xl font-bold mb-2" style="color: var(--foreground);">A self-hosted server is in development</h2>
      <p class="text-base leading-relaxed" style="color: var(--muted-foreground);">
        Today, PrismaLens ships as a CLI you run from your terminal. A self-hosted server —
        a web UI and webhook alert intake for triggering investigations from your existing
        monitoring stack — is on the roadmap, not yet released.
      </p>
    </div>
  </section>

  <CTA
    title="Ready to try it on a real alert?"
    description="Install the CLI, run pl doctor to check your setup, and investigate your first firing alert in a few minutes."
    href={`${docsBase}/cli/`}
    label="Get Started →"
  />
</BaseLayout>
