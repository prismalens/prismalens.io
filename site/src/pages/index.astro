---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import FeatureGrid from '../components/FeatureGrid.astro'
import CTA from '../components/CTA.astro'

const docsBase = import.meta.env.DEV ? 'http://localhost:4322' : 'https://docs.prismalens.io'

const features = [
  {
    title: 'It starts from the alert',
    description: 'Point Prometheus Alertmanager at PrismaLens. A firing alert opens an incident, and a critical or high alert on a known service starts an investigation on arrival. You pick the policy per service, or write the incident by hand.',
    icon: 'activity',
  },
  {
    title: 'Your coding agent, your login',
    description: 'PrismaLens hands the incident to an agent you already have: OpenCode by default, or Claude Code, Codex or Gemini CLI. It never calls a model itself. No PrismaLens account, no subscription, no model bill from us.',
    icon: 'bot',
  },
  {
    title: 'It works on a copy of your code',
    description: 'Each run gets a fresh snapshot of the service\'s last commit. Your checkout is never the working directory, and agent config committed in the repository is stripped before the agent starts.',
    icon: 'layers',
  },
  {
    title: 'Read-only, and honest about it',
    description: 'PrismaLens refuses the agent\'s edits, deletes and mutating commands. That is a guardrail, not a wall. Add a sandbox for an OS-enforced boundary, and every report says which one you got.',
    icon: 'shield',
  },
  {
    title: 'Ordered evidence, not scores',
    description: 'Hypotheses ranked most to least plausible, each backed by a file, line or command it actually ran. What was ruled out, what was and wasn\'t checked, and what to do next. No confidence percentages.',
    icon: 'search',
  },
  {
    title: 'One command, one folder',
    description: 'pl up serves the API and the dashboard on one port with SQLite in ~/.prismalens. No Docker, no Redis, nothing to host. pl doctor checks your agent before the first run.',
    icon: 'command',
  },
]

const limits = [
  'Runs are unsandboxed unless you install the sandbox runtime and ask for it.',
  'Prometheus Alertmanager is the only alert source.',
  'The agent gets the alert and the code. It does not connect to your metrics, logs or traces.',
  'One account per install, no roles.',
  'macOS, Linux and WSL2. Native Windows is not supported yet.',
]
---

<BaseLayout title="PrismaLens — your coding agent, investigating your incidents">
  <Hero
    title="Point it at an incident and the code behind it."
    subtitle="PrismaLens is an open-source app you run with one command. When an alert fires, your own coding agent investigates a read-only copy of the service's code, and you get a report that shows its evidence."
    code={['npm install -g prismalens', 'pl up']}
    codeNote="Node.js 24+. Opens the dashboard at localhost:3001."
    primaryCta={{ href: `${docsBase}/quickstart/`, label: 'Quick start' }}
    secondaryCta={{
      href: 'https://github.com/prismalens/prismalens',
      label: 'View on GitHub',
    }}
  />

  <section class="px-4 pb-24 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="mb-4 text-center text-sm" style="color: var(--muted-foreground);">
        A real 0.5.0 report. The alert said checkout latency jumped after a deploy; OpenCode found the unit bug that release introduced.
      </p>
      <img
        src="/screenshots/report-0.5.0.webp"
        width="1600"
        height="1246"
        alt="PrismaLens investigation report: the root cause names src/rates.js line 7 and commit 6907f00, a single supported hypothesis lists four pieces of evidence with file and line sources, the coverage panel separates what was checked from what was not, and a next step says how to fix it"
        class="w-full rounded-xl"
        style="border: 1px solid var(--border); box-shadow: 0 20px 60px color-mix(in srgb, var(--primary) 10%, transparent);"
        loading="lazy"
      />
    </div>
  </section>

  <FeatureGrid features={features} />

  <section class="px-4 py-24 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-6" style="color: var(--foreground);">
        Why not just ask the agent yourself?
      </h2>
      <div class="space-y-4 text-lg leading-relaxed" style="color: var(--muted-foreground);">
        <p>You can, and for a one-off question you should. PrismaLens is for everything around the question:</p>
        <ul class="space-y-3 pl-5 list-disc">
          <li><strong style="color: var(--foreground);">It starts from the alert.</strong> The alert details are already in the brief when the agent starts, and nobody has to be awake to paste them.</li>
          <li><strong style="color: var(--foreground);">It keeps the agent's hands off.</strong> The run happens in a snapshot, and PrismaLens answers every permission request with a read-only policy.</li>
          <li><strong style="color: var(--foreground);">It leaves a record, not a chat.</strong> A week later the report, the evidence and every command the agent ran are still on the incident.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="px-4 pb-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl rounded-2xl p-8" style="border: 1px dashed var(--border); background: color-mix(in srgb, var(--card) 60%, transparent);">
      <h2 class="text-xl font-bold mb-4" style="color: var(--foreground);">What 0.5.0 does not do</h2>
      <ul class="space-y-2 pl-5 list-disc text-base" style="color: var(--muted-foreground);">
        {limits.map((item) => <li>{item}</li>)}
      </ul>
      <p class="mt-4 text-sm" style="color: var(--muted-foreground);">
        The full account of what PrismaLens reads, sends and stores is in
        <a href={`${docsBase}/trust/`} class="underline" style="color: var(--primary);">What PrismaLens reads and never does</a>.
      </p>
    </div>
  </section>

  <CTA
    title="Try it in ten minutes"
    description="Install, start the app, point a service at a folder, and run one investigation. No alert source needed."
    href={`${docsBase}/quickstart/`}
    label="Quick start"
  />
</BaseLayout>
