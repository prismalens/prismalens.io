---
import BaseLayout from '../layouts/BaseLayout.astro'
import InstallBox from '../components/InstallBox.astro'
import LiveRun from '../components/LiveRun.astro'
import { githubUrl, quickstartUrl, trustUrl } from '../lib/links'

const agents = ['OpenCode', 'Claude Code', 'Codex', 'Gemini CLI', 'deepagents', '+ any ACP agent']
---

<BaseLayout title="Your agent, working while you're not" fullTitle="PrismaLens: AI root cause analysis with your own coding agent">
  <section class="hero" aria-labelledby="hero-title">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div>
        <h1 id="hero-title">Your agent,<br /><span class="grad">working while you're not.</span></h1>
        <p class="lede">Signals in. Your agent digs in. Evidence out.</p>
        <InstallBox name="hero" />
        <a class="more" href={quickstartUrl}>Read the docs →</a>
      </div>
      <LiveRun />
    </div>
  </section>

  <section class="sec" aria-label="What it does">
    <div class="wrap pillars">
      <article class="card reveal">
        <div class="vis" aria-hidden="true">
          <svg class="art" viewBox="0 0 340 190" fill="none">
            <g stroke="oklch(1 0 0 / .14)" stroke-width="1.5">
              <path d="M74 45C150 45 170 95 236 95"></path><path d="M74 95H236"></path><path d="M74 145C150 145 170 95 236 95"></path>
            </g>
            <g stroke="var(--live)" stroke-width="1.8" class="flowpath">
              <path d="M74 45C150 45 170 95 236 95"></path><path d="M74 95H236" style="animation-delay:-.4s"></path><path d="M74 145C150 145 170 95 236 95" style="animation-delay:-.8s"></path>
            </g>
            <g stroke="oklch(0.92 0.005 286)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="56" cy="45" r="19" fill="oklch(0.19 0.007 285.9)" stroke="oklch(1 0 0 / .14)"></circle>
              <path d="M51 49h10M52.5 49v-5a3.5 3.5 0 017 0v5M55 52h2"></path>
              <circle cx="56" cy="95" r="19" fill="oklch(0.19 0.007 285.9)" stroke="oklch(1 0 0 / .14)"></circle>
              <path d="M50 99l4-7M62 99h-8M58 89l4 7"></path><circle cx="54" cy="91" r="1.4"></circle><circle cx="50" cy="100" r="1.4"></circle><circle cx="62" cy="100" r="1.4"></circle>
              <circle cx="56" cy="145" r="19" fill="oklch(0.19 0.007 285.9)" stroke="oklch(1 0 0 / .14)"></circle>
              <path d="M49 140h14v8h-8l-4 3v-3h-2z"></path>
            </g>
            <circle cx="254" cy="95" r="26" fill="color-mix(in oklch, var(--primary) 18%, transparent)" class="breathe"></circle>
            <circle cx="254" cy="95" r="16" fill="var(--primary)"></circle>
            <path d="M248 95h12M256 91l4 4-4 4" stroke="var(--primary-foreground)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
        <h2>Any signal</h2>
        <p>Alerts, webhooks, or you.</p>
      </article>
      <article class="card reveal" style="--d:.08s">
        <div class="vis" aria-hidden="true">
          <svg class="art" viewBox="0 0 340 190" fill="none">
            <path d="M30 130H310" stroke="oklch(1 0 0 / .18)" stroke-width="2"></path>
            <path class="flowpath" d="M110 130C140 130 140 95 170 95H310" stroke="var(--ring)" stroke-width="2"></path>
            <circle cx="110" cy="130" r="6" fill="var(--card)" stroke="var(--foreground)" stroke-width="2"></circle>
            <circle cx="310" cy="130" r="4" fill="var(--muted-foreground)"></circle>
            <circle cx="170" cy="95" r="30" stroke="oklch(1 0 0 / .08)" stroke-dasharray="3 5"></circle>
            <g class="orbit"><circle cx="200" cy="95" r="5" fill="var(--live)"></circle></g>
            <rect x="155" y="80" width="30" height="30" rx="7" fill="var(--primary)"></rect>
            <path d="M163 90l5 5-5 5M171 100h7" stroke="var(--primary-foreground)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            <g fill="oklch(1 0 0 / .12)"><rect x="34" y="40" width="44" height="6" rx="3"></rect><rect x="34" y="54" width="30" height="6" rx="3"></rect><rect x="34" y="68" width="38" height="6" rx="3"></rect></g>
            <g fill="color-mix(in oklch, var(--ring) 35%, transparent)"><rect x="236" y="40" width="44" height="6" rx="3"></rect><rect x="236" y="54" width="30" height="6" rx="3"></rect><rect x="236" y="68" width="38" height="6" rx="3"></rect></g>
          </svg>
        </div>
        <h2>Your agent</h2>
        <p>The one you already pay for.</p>
        <ul class="agents" aria-label="Supported agents">
          {agents.map((a) => <li>{a}</li>)}
        </ul>
      </article>
      <article class="card reveal" style="--d:.16s">
        <div class="vis" data-load aria-hidden="true">
          <div class="skel"><i></i><i></i><i></i></div>
          <div class="mini">
            <div class="mrow top"><span class="rank">1</span><span class="ln"></span><span class="dots"><i></i><i></i></span><span class="str s4"><i></i><i></i><i></i><i></i></span></div>
            <div class="mrow"><span class="rank">2</span><span class="ln" style="max-width:70%"></span><span class="dots"><i></i></span><span class="str s2"><i></i><i></i><i></i><i></i></span></div>
            <div class="mrow"><span class="rank">3</span><span class="ln" style="max-width:55%"></span><span class="dots"><i></i></span><span class="str s1"><i></i><i></i><i></i><i></i></span></div>
          </div>
        </div>
        <h2>Evidence, ranked</h2>
        <p>What it found, and why.</p>
      </article>
    </div>
  </section>

  <section class="trust" aria-label="Trust">
    <div class="wrap">
      <ul class="reveal">
        <li><a href={githubUrl}><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 4L1.5 8 5 12M11 4l3.5 4-3.5 4"></path></svg>Open source</a></li>
        <li><a href={trustUrl}><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2" y="3" width="12" height="8" rx="1.5"></rect><path d="M5.5 14h5M8 11v3"></path></svg>Runs on your machine</a></li>
        <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="5.5" r="2.5"></circle><path d="M3 14c.6-2.6 2.6-4 5-4s4.4 1.4 5 4M2 2l12 12"></path></svg>No account</li>
        <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6"></circle><path d="M3.8 3.8l8.4 8.4"></path></svg>No model bill</li>
        <li><a href={trustUrl}><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 1.5l5.5 2v4c0 3.5-2.4 6-5.5 7-3.1-1-5.5-3.5-5.5-7v-4z"></path><path d="M5.5 8l1.8 1.8L10.8 6.3"></path></svg>You approve what it does</a></li>
      </ul>
    </div>
  </section>

  <section class="cta" id="install" aria-labelledby="cta-title">
    <div class="wrap">
      <h2 id="cta-title" class="reveal">Try it in a minute.</h2>
      <InstallBox name="closing" class="reveal" center />
      <a class="btn btn-ghost gh reveal" href={githubUrl}>
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
        GitHub
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: 84px 0 110px;
    isolation: isolate;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: linear-gradient(oklch(1 0 0 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, oklch(1 0 0 / 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
  }
  .glow {
    position: absolute;
    z-index: -1;
    inset: -30% -10% auto;
    height: 900px;
    background: conic-gradient(
      from 200deg at 50% 50%,
      transparent 0deg,
      color-mix(in oklch, var(--primary) 35%, transparent) 60deg,
      color-mix(in oklch, var(--chart-2) 22%, transparent) 110deg,
      transparent 170deg,
      color-mix(in oklch, var(--live) 14%, transparent) 250deg,
      transparent 320deg
    );
    filter: blur(90px);
    opacity: 0.7;
    animation: spin 28s linear infinite;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 48px;
    align-items: center;
  }
  h1 {
    font-size: clamp(40px, 5.6vw, 68px);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0 0 22px;
    font-weight: 650;
  }
  .grad {
    background: linear-gradient(100deg, var(--foreground) 10%, color-mix(in oklch, var(--ring) 55%, white) 45%, color-mix(in oklch, var(--chart-2) 70%, white) 75%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    font-size: 19px;
    line-height: 1.5;
    color: var(--muted-foreground);
    margin: 0 0 34px;
  }
  .more {
    display: inline-flex;
    margin-top: 18px;
    font-size: 14px;
    font-weight: 500;
  }

  .sec {
    padding: 110px 0;
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .card {
    position: relative;
    border-radius: 16px;
    border: 1px solid oklch(1 0 0 / 0.08);
    background: linear-gradient(180deg, oklch(0.18 0.006 285.9), oklch(0.15 0.006 285.9));
    padding: 20px 20px 24px;
    overflow: hidden;
    transition: border-color 0.3s;
  }
  .card:hover {
    border-color: oklch(1 0 0 / 0.16);
  }
  .card h2 {
    font-size: 21px;
    margin: 22px 0 4px;
    letter-spacing: -0.02em;
    font-weight: 620;
  }
  .card p {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 15px;
  }
  .vis {
    height: 190px;
    border-radius: 12px;
    background: radial-gradient(120% 90% at 50% 0%, color-mix(in oklch, var(--primary) 10%, transparent), transparent 70%), oklch(0 0 0 / 0.25);
    border: 1px solid oklch(1 0 0 / 0.06);
    display: grid;
    place-items: center;
    overflow: hidden;
    position: relative;
  }
  .art {
    width: 100%;
    height: 100%;
  }
  .flowpath {
    stroke-dasharray: 4 6;
    animation: dash 1.2s linear infinite;
  }
  .orbit {
    transform-origin: 170px 95px;
    animation: spin 6s linear infinite;
  }
  .breathe {
    animation: breathe 2.6s ease-in-out infinite;
  }
  .mini,
  .skel {
    width: 84%;
    flex-direction: column;
    gap: 9px;
  }
  .mini {
    display: none;
  }
  .skel {
    display: flex;
  }
  .skel i {
    display: block;
    height: 36px;
    border-radius: 9px;
    background: linear-gradient(90deg, oklch(1 0 0 / 0.04) 0%, oklch(1 0 0 / 0.1) 40%, oklch(1 0 0 / 0.04) 80%);
    background-size: 300% 100%;
    animation: shimmer 1.4s linear infinite;
  }
  .is-loaded .skel {
    display: none;
  }
  .is-loaded .mini {
    display: flex;
  }
  .is-loaded .mrow {
    animation: slide 0.5s var(--ease-out-soft) both;
  }
  .is-loaded .mrow:nth-child(2) {
    animation-delay: 0.12s;
  }
  .is-loaded .mrow:nth-child(3) {
    animation-delay: 0.24s;
  }
  .mrow {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 9px;
    border: 1px solid oklch(1 0 0 / 0.08);
    background: oklch(1 0 0 / 0.025);
  }
  .mrow.top {
    border-color: color-mix(in oklch, var(--run-done) 40%, transparent);
    background: color-mix(in oklch, var(--run-done) 7%, transparent);
  }
  .rank {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    display: grid;
    place-items: center;
    font: 600 11px/1 var(--font-mono);
    background: oklch(1 0 0 / 0.07);
    color: var(--foreground);
  }
  .mrow.top .rank {
    background: var(--run-done);
    color: var(--bg-deep);
  }
  .ln {
    flex: 1;
    height: 7px;
    border-radius: 4px;
    background: oklch(1 0 0 / 0.14);
  }
  .dots {
    display: flex;
    gap: 3px;
  }
  .dots i {
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: oklch(1 0 0 / 0.25);
  }
  .str {
    display: inline-flex;
    gap: 3px;
    align-items: center;
  }
  .str i {
    width: 12px;
    height: 5px;
    border-radius: 2px;
    background: oklch(1 0 0 / 0.1);
  }
  .str.s1 i:nth-child(-n + 1),
  .str.s2 i:nth-child(-n + 2) {
    background: var(--ring);
  }
  .mrow.top .str.s4 i {
    background: var(--run-done);
  }

  .trust {
    padding: 10px 0 40px;
  }
  .trust ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }
  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font: 500 14px/1 var(--font-sans);
    padding: 12px 16px;
    border-radius: 999px;
    border: 1px solid oklch(1 0 0 / 0.09);
    background: oklch(1 0 0 / 0.025);
    color: oklch(0.92 0.005 286);
  }
  .trust li:has(a) {
    padding: 0;
  }
  .trust a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 16px;
    border-radius: inherit;
    color: inherit;
  }
  .trust a:hover {
    color: var(--foreground);
    background: oklch(1 0 0 / 0.04);
    text-decoration: none;
  }
  .agents {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .agents li {
    font: 500 12px/1 var(--font-mono);
    padding: 6px 9px;
    border-radius: 7px;
    border: 1px solid oklch(1 0 0 / 0.1);
    background: oklch(0 0 0 / 0.22);
    color: oklch(0.88 0.005 286);
  }
  .agents li:last-child {
    color: var(--muted-foreground);
    border-style: dashed;
  }
  .trust li svg {
    width: 15px;
    height: 15px;
    color: var(--run-done);
    flex: none;
  }

  .cta {
    position: relative;
    padding: 120px 0 130px;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }
  .cta::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 45%;
    width: 900px;
    height: 500px;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, color-mix(in oklch, var(--primary) 32%, transparent), transparent);
    filter: blur(30px);
  }
  .cta h2 {
    font-size: clamp(34px, 4.8vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0 0 34px;
    font-weight: 640;
  }
  .cta :global(.installer) {
    text-align: left;
  }
  .gh {
    margin-top: 26px;
  }

  @media (max-width: 1020px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 900px) {
    .pillars {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .glow {
      animation: none;
    }
  }
  @media (forced-colors: active) {
    .trust li {
      border: 1px solid CanvasText;
    }
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @keyframes dash {
    to { stroke-dashoffset: -20; }
  }
  @keyframes breathe {
    50% { opacity: 0.45; }
  }
  @keyframes shimmer {
    from { background-position: 100% 0; }
    to { background-position: -50% 0; }
  }
  @keyframes slide {
    from { opacity: 0; transform: translateX(18px) scale(0.985); }
    to { opacity: 1; transform: none; }
  }
</style>
