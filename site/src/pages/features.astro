---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import FeatureGrid from '../components/FeatureGrid.astro'
import CTA from '../components/CTA.astro'

const docsBase = import.meta.env.DEV ? 'http://localhost:4322' : 'https://docs.prismalens.io'

const coreFeatures = [
  {
    title: 'Two ways to start an investigation',
    description:
      'Pipe in a FiringAlert JSON (or a webhook/Alertmanager-shaped payload) on stdin, or skip the alert and describe the problem with --query. Either way, the CLI streams a live timeline as it works.',
    icon: 'search',
  },
  {
    title: 'Ordered-evidence reports',
    description:
      'Every report has the same shape: a root cause (or an honest "not determined"), hypotheses ranked by plausibility with supporting/contradicting evidence, what was ruled out, coverage, and next steps. No numeric confidence scores.',
    icon: 'activity',
  },
  {
    title: 'BYO model provider',
    description:
      'The default deepagents harness speaks the OpenAI protocol — Ollama, OpenAI, Groq, or your own OpenAI-compatible endpoint. Prefer Claude Code? Use --harness claude-code with your Anthropic credential instead.',
    icon: 'link',
  },
  {
    title: 'Permission modes',
    description:
      '--mode controls what the harness is asked to do: read-only (default), supervised, auto, or dangerous. --dangerously-skip-permissions is a shortcut for the last one.',
    icon: 'shield',
  },
  {
    title: 'Sandboxed isolation, with a self-check',
    description:
      '--sandbox auto prefers an enforced OS-level boundary (srt) and only falls back to the cooperative process floor once a real egress self-check says the boundary would actually work — and says so, never silently.',
    icon: 'unlock',
  },
  {
    title: 'Every run persisted, JSON for scripting',
    description:
      'Each investigation writes its event stream and report under ~/.prismalens/runs/<runId>/. Add --json to print the InvestigationReport as machine-readable output, or --output to save a copy.',
    icon: 'layers',
  },
]
---

<BaseLayout title="Features" description="What the PrismaLens CLI does today — read-only AI investigation, BYO-key model providers, and an enforced sandbox.">
  <Hero
    title="What the CLI does today"
    subtitle="A terminal tool that investigates a firing alert like an on-call engineer would, and hands you back a report you can check line by line."
  />
  <FeatureGrid features={coreFeatures} />

  <!-- In development -->
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl rounded-2xl p-8" style="border: 1px dashed var(--border); background: color-mix(in srgb, var(--card) 60%, transparent);">
      <h2 class="text-xl font-bold mb-4 text-center" style="color: var(--foreground);">In development — not yet released</h2>
      <ul class="mx-auto max-w-md space-y-2 text-base" style="color: var(--muted-foreground);">
        <li>&bull; A self-hosted web UI</li>
        <li>&bull; An incident command center</li>
        <li>&bull; Webhook alert intake from your existing monitoring stack</li>
        <li>&bull; Multi-source correlation across incidents</li>
      </ul>
    </div>
  </section>

  <CTA
    title="See it in action"
    description="Install the CLI and run your first read-only investigation against a real repo."
    href={`${docsBase}/cli/`}
    label="Read the CLI docs"
  />
</BaseLayout>
