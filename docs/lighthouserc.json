{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      },
      "url": [
        "http://localhost/index.html",
        "http://localhost/quickstart/index.html",
        "http://localhost/install/index.html",
        "http://localhost/coding-agents/index.html",
        "http://localhost/guides/alerts/index.html",
        "http://localhost/guides/reports/index.html",
        "http://localhost/trust/index.html",
        "http://localhost/reference/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
