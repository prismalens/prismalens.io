---
import Default from '@astrojs/starlight/components/Banner.astro';
---

<div class="alpha-banner" data-pagefind-ignore>
	PrismaLens is alpha and changes often. These docs describe the latest release; read the
	<a href="https://github.com/prismalens/prismalens/releases">release notes</a> before upgrading.
</div>
<Default />

<style>
	.alpha-banner {
		margin: 1rem var(--sl-content-pad-x, 1rem) 0;
		padding: 0.5rem 0.875rem;
		border: 1px solid color-mix(in oklch, var(--primary) 35%, transparent);
		border-radius: 10px;
		background-color: color-mix(in oklch, var(--primary) 10%, transparent);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
		text-wrap: balance;
	}
	.alpha-banner a {
		color: var(--sl-color-text-accent);
	}
</style>
