---
import Default from '@astrojs/starlight/components/Footer.astro'
---

<Default><slot /></Default>
<p class="docs-license">
  Docs text is licensed
  <a href="https://creativecommons.org/licenses/by/4.0/">CC-BY-4.0</a>. PrismaLens is open source under
  <a href="https://github.com/prismalens/prismalens/blob/main/LICENSE">Apache-2.0</a>.
</p>

<script>
  import { initAnalytics } from '../scripts/analytics'
  initAnalytics().catch(() => {})

  const steps = document.querySelectorAll('.sl-steps > li')
  if (steps.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('seen')),
      { rootMargin: '0px 0px -45% 0px' },
    )
    steps.forEach((li) => io.observe(li))
  }
</script>

<style>
  .docs-license {
    margin-top: 1.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .docs-license a {
    color: inherit;
  }
  .docs-license a:hover {
    color: var(--sl-color-white);
  }
</style>
